{
  "name": "@makeup/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "pnpm --filter @makeup/database build",
    "dev": "pnpm build && pnpm --parallel run \"/^dev:(compile|serve)$/\"",
    "dev:compile": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:serve": "node --watch --watch-preserve-output dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@makeup/database": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/swagger": "catalog:",
    "@node-rs/argon2": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "dotenv": "catalog:",
    "exceljs": "catalog:",
    "jose": "catalog:",
    "redis": "catalog:",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
