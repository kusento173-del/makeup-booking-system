generator client {
  provider        = "prisma-client"
  output          = "../packages/database/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Site {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code       String   @unique(map: "sites_code_uq") @db.VarChar(32)
  name       String   @unique(map: "sites_name_uq") @db.VarChar(64)
  timezone   String   @default("Asia/Shanghai") @db.VarChar(64)
  status     String   @default("ACTIVE") @db.VarChar(16)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion Int      @default(1) @map("row_version")

  hosts               HostProfile[]
  artists             ArtistProfile[]
  operators           OperatorProfile[]
  userRoles           UserRole[]
  operationLogs       OperationLog[]
  bindingCodes        AccountBindingCode[]
  shiftChangeRequests ArtistShiftChangeRequest[]
  artistOvertimes     ArtistOvertime[]
  appointments        Appointment[]
  fixedRequests       FixedAppointmentRequest[]
  fixedRules          FixedAppointmentRule[]
  exportJobs          ExportJob[]
  notificationTasks   NotificationTask[]
  notificationSubscriptionDecisions NotificationSubscriptionDecision[]

  @@index([status, sortOrder], map: "sites_status_sort_order_idx")
  @@map("sites")
}

model AppUser {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  displayName      String    @map("display_name") @db.VarChar(64)
  mobileCiphertext String?   @map("mobile_ciphertext") @db.Text
  mobileHash       String?   @unique(map: "app_users_mobile_hash_uq") @map("mobile_hash") @db.Char(64)
  mobileLast4      String?   @map("mobile_last4") @db.Char(4)
  status           String    @default("ACTIVE") @db.VarChar(16)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion       Int       @default(1) @map("row_version")

  identities              UserIdentity[]
  passwordCredential      PasswordCredential?
  roles                   UserRole[]                   @relation("UserRoleOwner")
  assignedRoles           UserRole[]                   @relation("UserRoleAssigner")
  sessions                AuthSession[]
  operationLogs           OperationLog[]
  hostProfile             HostProfile?
  artistProfile           ArtistProfile?
  operatorProfile         OperatorProfile?
  qualificationChanges    HostQualificationHistory[]   @relation("HostQualificationChangedBy")
  uploadedImportBatches   ImportBatch[]                @relation("ImportBatchUploader")
  confirmedImportBatches  ImportBatch[]                @relation("ImportBatchConfirmer")
  createdBindingCodes     AccountBindingCode[]         @relation("BindingCodeCreator")
  consumedBindingCodes    AccountBindingCode[]         @relation("BindingCodeConsumer")
  revokedBindingCodes     AccountBindingCode[]         @relation("BindingCodeRevoker")
  bindingChallenges       AuthBindingChallenge[]
  roleSelectionChallenges AuthRoleSelectionChallenge[]
  createdShiftTemplates   ArtistShiftTemplate[]        @relation("ArtistShiftCreatedBy")
  submittedShiftChanges   ArtistShiftChangeRequest[]   @relation("ArtistShiftSubmittedBy")
  reviewedShiftChanges    ArtistShiftChangeRequest[]   @relation("ArtistShiftReviewedBy")
  submittedOvertimes      ArtistOvertime[]             @relation("ArtistOvertimeSubmittedBy")
  reviewedOvertimes       ArtistOvertime[]             @relation("ArtistOvertimeReviewedBy")
  createdLeaveRecords     LeaveRecord[]                @relation("LeaveRecordCreatedBy")
  cancelledLeaveRecords   LeaveRecord[]                @relation("LeaveRecordCancelledBy")
  createdAppointments     Appointment[]                @relation("AppointmentCreatedBy")
  cancelledAppointments   Appointment[]                @relation("AppointmentCancelledBy")
  idempotencyRecords      IdempotencyRecord[]
  submittedFixedRequests  FixedAppointmentRequest[]    @relation("FixedRequestSubmittedBy")
  reviewedFixedRequests   FixedAppointmentRequest[]    @relation("FixedRequestReviewedBy")
  requestedExportJobs     ExportJob[]                  @relation("ExportJobRequester")
  notificationTasks       NotificationTask[]           @relation("NotificationRecipient")
  notificationSubscriptionDecisions NotificationSubscriptionDecision[]

  @@index([status], map: "app_users_status_idx")
  @@map("app_users")
}

model UserIdentity {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String   @db.VarChar(32)
  providerAppId   String   @map("provider_app_id") @db.VarChar(128)
  externalSubject String   @map("external_subject") @db.VarChar(256)
  unionId         String?  @map("union_id") @db.VarChar(256)
  status          String   @default("ACTIVE") @db.VarChar(16)
  boundAt         DateTime @default(now()) @map("bound_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion      Int      @default(1) @map("row_version")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, providerAppId, externalSubject], map: "user_identities_provider_subject_uq")
  @@index([userId, status], map: "user_identities_user_status_idx")
  @@index([unionId], map: "user_identities_union_id_idx")
  @@map("user_identities")
}

model PasswordCredential {
  userId             String    @id @map("user_id") @db.Uuid
  passwordHash       String    @map("password_hash") @db.Text
  passwordChangedAt  DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  failedAttemptCount Int       @default(0) @map("failed_attempt_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("password_credentials")
}

model UserRole {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  roleCode         String    @map("role_code") @db.VarChar(32)
  siteId           String?   @map("site_id") @db.Uuid
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion       Int       @default(1) @map("row_version")

  user       AppUser       @relation("UserRoleOwner", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site       Site?         @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedBy AppUser?      @relation("UserRoleAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sessions   AuthSession[]

  @@unique([userId, roleCode], map: "user_roles_active_role_uq", where: raw("(revoked_at IS NULL)"))
  @@index([siteId, roleCode, revokedAt], map: "user_roles_site_role_revoked_idx")
  @@index([assignedByUserId], map: "user_roles_assigned_by_idx")
  @@map("user_roles")
}

model AuthSession {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  roleAssignmentId String?   @map("role_assignment_id") @db.Uuid
  refreshTokenHash String    @unique(map: "auth_sessions_refresh_token_hash_uq") @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason     String?   @map("revoke_reason") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion       Int       @default(1) @map("row_version")

  user           AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roleAssignment UserRole? @relation(fields: [roleAssignmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, revokedAt, expiresAt], map: "auth_sessions_user_validity_idx")
  @@index([roleAssignmentId, revokedAt], map: "auth_sessions_role_revoked_idx")
  @@map("auth_sessions")
}

model AuthBindingChallenge {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique(map: "auth_binding_challenges_token_hash_uq") @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId], map: "auth_binding_challenges_active_user_uq", where: raw("(consumed_at IS NULL AND revoked_at IS NULL)"))
  @@index([expiresAt], map: "auth_binding_challenges_expires_idx")
  @@map("auth_binding_challenges")
}

model AuthRoleSelectionChallenge {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique(map: "auth_role_selection_challenges_token_hash_uq") @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId], map: "auth_role_selection_challenges_active_user_uq", where: raw("(consumed_at IS NULL AND revoked_at IS NULL)"))
  @@index([expiresAt], map: "auth_role_selection_challenges_expires_idx")
  @@map("auth_role_selection_challenges")
}

model HostProfile {
  id                       String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                   String?  @unique(map: "host_profiles_user_id_uq") @map("user_id") @db.Uuid
  hostCode                 String   @unique(map: "host_profiles_host_code_uq") @map("host_code") @db.VarChar(32)
  realName                 String   @map("real_name") @db.VarChar(64)
  nickname                 String?  @db.VarChar(64)
  siteId                   String   @map("site_id") @db.Uuid
  qualificationStatus      String   @default("ACTIVE") @map("qualification_status") @db.VarChar(16)
  qualificationEffectiveAt DateTime @default(now()) @map("qualification_effective_at") @db.Timestamptz(3)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion               Int      @default(1) @map("row_version")
  sourceImportBatchId      String?  @map("source_import_batch_id") @db.Uuid

  site                   Site                       @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user                   AppUser?                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceImportBatch      ImportBatch?               @relation("HostSourceImportBatch", fields: [sourceImportBatchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  operatorRelations      HostOperatorRelation[]
  qualificationHistories HostQualificationHistory[]
  bindingCodes           AccountBindingCode[]
  leaveRecords           LeaveRecord[]
  appointments           Appointment[]
  fixedRequests          FixedAppointmentRequest[]
  fixedRules             FixedAppointmentRule[]

  @@unique([id, siteId], map: "host_profiles_id_site_uq")
  @@index([realName], map: "host_profiles_real_name_idx")
  @@index([siteId, qualificationStatus], map: "host_profiles_site_status_idx")
  @@index([sourceImportBatchId], map: "host_profiles_source_import_batch_idx")
  @@map("host_profiles")
}

model HostQualificationHistory {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  hostId          String   @map("host_id") @db.Uuid
  fromStatus      String?  @map("from_status") @db.VarChar(16)
  toStatus        String   @map("to_status") @db.VarChar(16)
  effectiveAt     DateTime @map("effective_at") @db.Timestamptz(3)
  changedByUserId String?  @map("changed_by_user_id") @db.Uuid
  reason          String?  @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  host      HostProfile @relation(fields: [hostId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  changedBy AppUser?    @relation("HostQualificationChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([hostId, effectiveAt(sort: Desc)], map: "host_qualification_histories_host_effective_idx")
  @@index([changedByUserId, createdAt(sort: Desc)], map: "host_qualification_histories_actor_created_idx")
  @@map("host_qualification_histories")
}

model ArtistProfile {
  id                       String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                   String?   @unique(map: "artist_profiles_user_id_uq") @map("user_id") @db.Uuid
  realName                 String    @map("real_name") @db.VarChar(64)
  nickname                 String    @db.VarChar(64)
  nicknameNormalized       String    @unique(map: "artist_profiles_active_nickname_uq", where: raw("((employment_status)::text = 'ACTIVE'::text)")) @map("nickname_normalized") @db.VarChar(64)
  siteId                   String    @map("site_id") @db.Uuid
  employmentStatus         String    @default("ACTIVE") @map("employment_status") @db.VarChar(16)
  initialShiftConfiguredAt DateTime? @map("initial_shift_configured_at") @db.Timestamptz(3)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion               Int       @default(1) @map("row_version")
  sourceImportBatchId      String?   @map("source_import_batch_id") @db.Uuid

  site                Site                       @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user                AppUser?                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceImportBatch   ImportBatch?               @relation("ArtistSourceImportBatch", fields: [sourceImportBatchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bindingCodes        AccountBindingCode[]
  shiftTemplates      ArtistShiftTemplate[]
  shiftChangeRequests ArtistShiftChangeRequest[]
  overtimes           ArtistOvertime[]
  leaveRecords        LeaveRecord[]
  appointments        Appointment[]
  targetFixedRequests FixedAppointmentRequest[]
  fixedRules          FixedAppointmentRule[]

  @@unique([id, siteId], map: "artist_profiles_id_site_uq")
  @@index([realName], map: "artist_profiles_real_name_idx")
  @@index([siteId, employmentStatus], map: "artist_profiles_site_status_idx")
  @@index([sourceImportBatchId], map: "artist_profiles_source_import_batch_idx")
  @@map("artist_profiles")
}

model ArtistShiftTemplate {
  id               String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  artistId         String                    @map("artist_id") @db.Uuid
  versionNo        Int                       @map("version_no")
  workdays         Int[]                     @db.SmallInt
  workStartMinute  Int                       @map("work_start_minute") @db.SmallInt
  breakStartMinute Int?                      @map("break_start_minute") @db.SmallInt
  breakEndMinute   Int?                      @map("break_end_minute") @db.SmallInt
  workEndMinute    Int                       @map("work_end_minute") @db.SmallInt
  validFrom        DateTime                  @map("valid_from") @db.Date
  validUntil       DateTime?                 @map("valid_until") @db.Date
  createdByUserId  String?                   @map("created_by_user_id") @db.Uuid
  sourceRequestId  String?                   @map("source_request_id") @db.Uuid
  activeRange      Unsupported("daterange")? @default(dbgenerated("daterange(valid_from, valid_until, '[)'::text)")) @map("active_range")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  artist             ArtistProfile              @relation(fields: [artistId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy          AppUser?                   @relation("ArtistShiftCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceRequest      ArtistShiftChangeRequest?  @relation("ArtistShiftResult", fields: [sourceRequestId, artistId], references: [id, artistId], onDelete: Restrict, onUpdate: Cascade, map: "artist_shift_templates_source_request_artist_fkey")
  currentForRequests ArtistShiftChangeRequest[] @relation("ArtistShiftCurrent")

  @@unique([artistId, versionNo], map: "artist_shift_templates_artist_version_uq")
  @@unique([id, artistId], map: "artist_shift_templates_id_artist_uq")
  @@unique([sourceRequestId, artistId], map: "artist_shift_templates_source_request_artist_uq")
  @@index([artistId, validFrom(sort: Desc)], map: "artist_shift_templates_artist_valid_from_idx")
  @@index([createdByUserId], map: "artist_shift_templates_created_by_idx")
  @@map("artist_shift_templates")
}

model ArtistShiftChangeRequest {
  id                       String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  artistId                 String    @map("artist_id") @db.Uuid
  siteId                   String    @map("site_id") @db.Uuid
  currentShiftId           String    @map("current_shift_id") @db.Uuid
  proposedWorkdays         Int[]     @map("proposed_workdays") @db.SmallInt
  proposedWorkStartMinute  Int       @map("proposed_work_start_minute") @db.SmallInt
  proposedBreakStartMinute Int?      @map("proposed_break_start_minute") @db.SmallInt
  proposedBreakEndMinute   Int?      @map("proposed_break_end_minute") @db.SmallInt
  proposedWorkEndMinute    Int       @map("proposed_work_end_minute") @db.SmallInt
  effectiveFrom            DateTime  @map("effective_from") @db.Date
  reason                   String    @db.VarChar(500)
  status                   String    @default("PENDING") @db.VarChar(16)
  submittedByUserId        String    @map("submitted_by_user_id") @db.Uuid
  submittedAt              DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedByUserId         String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt               DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewComment            String?   @map("review_comment") @db.VarChar(500)
  affectedAppointmentCount Int       @default(0) @map("affected_appointment_count")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion               Int       @default(1) @map("row_version")

  artist         ArtistProfile        @relation(fields: [artistId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site           Site                 @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentShift   ArtistShiftTemplate  @relation("ArtistShiftCurrent", fields: [currentShiftId, artistId], references: [id, artistId], onDelete: Restrict, onUpdate: Cascade, map: "artist_shift_change_requests_current_shift_artist_fkey")
  submittedBy    AppUser              @relation("ArtistShiftSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy     AppUser?             @relation("ArtistShiftReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resultingShift ArtistShiftTemplate? @relation("ArtistShiftResult")

  @@unique([id, artistId], map: "artist_shift_change_requests_id_artist_uq")
  @@unique([artistId], map: "artist_shift_change_requests_pending_artist_uq", where: raw("((status)::text = 'PENDING'::text)"))
  @@index([siteId, status, submittedAt], map: "artist_shift_change_requests_site_status_submitted_idx")
  @@index([submittedByUserId], map: "artist_shift_change_requests_submitted_by_idx")
  @@index([reviewedByUserId], map: "artist_shift_change_requests_reviewed_by_idx")
  @@map("artist_shift_change_requests")
}

model ArtistOvertime {
  id                       String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  artistId                 String    @map("artist_id") @db.Uuid
  siteId                   String    @map("site_id") @db.Uuid
  overtimeDate             DateTime  @map("overtime_date") @db.Date
  workStartMinute          Int       @map("work_start_minute") @db.SmallInt
  breakStartMinute         Int?      @map("break_start_minute") @db.SmallInt
  breakEndMinute           Int?      @map("break_end_minute") @db.SmallInt
  workEndMinute            Int       @map("work_end_minute") @db.SmallInt
  reason                   String    @db.VarChar(500)
  status                   String    @default("PENDING") @db.VarChar(16)
  submittedByUserId        String    @map("submitted_by_user_id") @db.Uuid
  submittedAt              DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedByUserId         String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt               DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewComment            String?   @map("review_comment") @db.VarChar(500)
  affectedAppointmentCount Int       @default(0) @map("affected_appointment_count")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion               Int       @default(1) @map("row_version")

  artist      ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site        Site          @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submittedBy AppUser       @relation("ArtistOvertimeSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy  AppUser?      @relation("ArtistOvertimeReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([artistId, overtimeDate], map: "artist_overtimes_active_artist_date_uq", where: raw("((status)::text = ANY ((ARRAY['PENDING'::character varying, 'APPROVED'::character varying])::text[]))"))
  @@index([siteId, status, overtimeDate], map: "artist_overtimes_site_status_date_idx")
  @@index([submittedByUserId], map: "artist_overtimes_submitted_by_idx")
  @@index([reviewedByUserId], map: "artist_overtimes_reviewed_by_idx")
  @@map("artist_overtimes")
}

model LeaveRecord {
  id                       String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subjectType              String                    @map("subject_type") @db.VarChar(16)
  hostId                   String?                   @map("host_id") @db.Uuid
  artistId                 String?                   @map("artist_id") @db.Uuid
  startDate                DateTime                  @map("start_date") @db.Date
  endDate                  DateTime                  @map("end_date") @db.Date
  leaveRange               Unsupported("daterange")? @default(dbgenerated("daterange(start_date, (end_date + 1), '[)'::text)")) @map("leave_range")
  status                   String                    @default("ACTIVE") @db.VarChar(16)
  reason                   String?                   @db.VarChar(500)
  createdByUserId          String                    @map("created_by_user_id") @db.Uuid
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledByUserId        String?                   @map("cancelled_by_user_id") @db.Uuid
  cancelledAt              DateTime?                 @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason       String?                   @map("cancellation_reason") @db.VarChar(500)
