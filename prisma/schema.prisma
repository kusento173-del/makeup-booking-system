generator client {
  provider        = "prisma-client"
  output          = "../packages/database/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Site {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code       String   @unique(map: "sites_code_uq") @db.VarChar(32)
  name       String   @unique(map: "sites_name_uq") @db.VarChar(64)
  timezone   String   @default("Asia/Shanghai") @db.VarChar(64)
  status     String   @default("ACTIVE") @db.VarChar(16)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion Int      @default(1) @map("row_version")

  hosts               HostProfile[]
  artists             ArtistProfile[]
  operators           OperatorProfile[]
  userRoles           UserRole[]
  operationLogs       OperationLog[]
  bindingCodes        AccountBindingCode[]
  shiftChangeRequests ArtistShiftChangeRequest[]
  artistOvertimes     ArtistOvertime[]
  appointments        Appointment[]

  @@index([status, sortOrder], map: "sites_status_sort_order_idx")
  @@map("sites")
}

model AppUser {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  displayName      String    @map("display_name") @db.VarChar(64)
  mobileCiphertext String?   @map("mobile_ciphertext") @db.Text
  mobileHash       String?   @unique(map: "app_users_mobile_hash_uq") @map("mobile_hash") @db.Char(64)
  mobileLast4      String?   @map("mobile_last4") @db.Char(4)
  status           String    @default("ACTIVE") @db.VarChar(16)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion       Int       @default(1) @map("row_version")

  identities              UserIdentity[]
  passwordCredential      PasswordCredential?
  roles                   UserRole[]                   @relation("UserRoleOwner")
  assignedRoles           UserRole[]                   @relation("UserRoleAssigner")
  sessions                AuthSession[]
  operationLogs           OperationLog[]
  hostProfile             HostProfile?
  artistProfile           ArtistProfile?
  operatorProfile         OperatorProfile?
  qualificationChanges    HostQualificationHistory[]   @relation("HostQualificationChangedBy")
  uploadedImportBatches   ImportBatch[]                @relation("ImportBatchUploader")
  confirmedImportBatches  ImportBatch[]                @relation("ImportBatchConfirmer")
  createdBindingCodes     AccountBindingCode[]         @relation("BindingCodeCreator")
  consumedBindingCodes    AccountBindingCode[]         @relation("BindingCodeConsumer")
  revokedBindingCodes     AccountBindingCode[]         @relation("BindingCodeRevoker")
  bindingChallenges       AuthBindingChallenge[]
  roleSelectionChallenges AuthRoleSelectionChallenge[]
  createdShiftTemplates   ArtistShiftTemplate[]        @relation("ArtistShiftCreatedBy")
  submittedShiftChanges   ArtistShiftChangeRequest[]   @relation("ArtistShiftSubmittedBy")
  reviewedShiftChanges    ArtistShiftChangeRequest[]   @relation("ArtistShiftReviewedBy")
  submittedOvertimes      ArtistOvertime[]             @relation("ArtistOvertimeSubmittedBy")
  reviewedOvertimes       ArtistOvertime[]             @relation("ArtistOvertimeReviewedBy")
  createdLeaveRecords     LeaveRecord[]                @relation("LeaveRecordCreatedBy")
  cancelledLeaveRecords   LeaveRecord[]                @relation("LeaveRecordCancelledBy")
  createdAppointments     Appointment[]                @relation("AppointmentCreatedBy")
  cancelledAppointments   Appointment[]                @relation("AppointmentCancelledBy")

  @@index([status], map: "app_users_status_idx")
  @@map("app_users")
}

model UserIdentity {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String   @db.VarChar(32)
  providerAppId   String   @map("provider_app_id") @db.VarChar(128)
  externalSubject String   @map("external_subject") @db.VarChar(256)
  unionId         String?  @map("union_id") @db.VarChar(256)
  status          String   @default("ACTIVE") @db.VarChar(16)
  boundAt         DateTime @default(now()) @map("bound_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion      Int      @default(1) @map("row_version")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, providerAppId, externalSubject], map: "user_identities_provider_subject_uq")
  @@index([userId, status], map: "user_identities_user_status_idx")
  @@index([unionId], map: "user_identities_union_id_idx")
  @@map("user_identities")
}

model PasswordCredential {
  userId             String    @id @map("user_id") @db.Uuid
  passwordHash       String    @map("password_hash") @db.Text
  passwordChangedAt  DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  failedAttemptCount Int       @default(0) @map("failed_attempt_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("password_credentials")
}

model UserRole {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  roleCode         String    @map("role_code") @db.VarChar(32)
  siteId           String?   @map("site_id") @db.Uuid
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion       Int       @default(1) @map("row_version")

  user       AppUser       @relation("UserRoleOwner", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site       Site?         @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedBy AppUser?      @relation("UserRoleAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sessions   AuthSession[]

  @@unique([userId, roleCode], map: "user_roles_active_role_uq", where: raw("(revoked_at IS NULL)"))
  @@index([siteId, roleCode, revokedAt], map: "user_roles_site_role_revoked_idx")
  @@index([assignedByUserId], map: "user_roles_assigned_by_idx")
  @@map("user_roles")
}

model AuthSession {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  roleAssignmentId String?   @map("role_assignment_id") @db.Uuid
  refreshTokenHash String    @unique(map: "auth_sessions_refresh_token_hash_uq") @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason     String?   @map("revoke_reason") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion       Int       @default(1) @map("row_version")

  user           AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roleAssignment UserRole? @relation(fields: [roleAssignmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, revokedAt, expiresAt], map: "auth_sessions_user_validity_idx")
  @@index([roleAssignmentId, revokedAt], map: "auth_sessions_role_revoked_idx")
  @@map("auth_sessions")
}

model AuthBindingChallenge {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique(map: "auth_binding_challenges_token_hash_uq") @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId], map: "auth_binding_challenges_active_user_uq", where: raw("(consumed_at IS NULL AND revoked_at IS NULL)"))
  @@index([expiresAt], map: "auth_binding_challenges_expires_idx")
  @@map("auth_binding_challenges")
}

model AuthRoleSelectionChallenge {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique(map: "auth_role_selection_challenges_token_hash_uq") @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId], map: "auth_role_selection_challenges_active_user_uq", where: raw("(consumed_at IS NULL AND revoked_at IS NULL)"))
  @@index([expiresAt], map: "auth_role_selection_challenges_expires_idx")
  @@map("auth_role_selection_challenges")
}

model HostProfile {
  id                       String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                   String?  @unique(map: "host_profiles_user_id_uq") @map("user_id") @db.Uuid
  hostCode                 String   @unique(map: "host_profiles_host_code_uq") @map("host_code") @db.VarChar(32)
  realName                 String   @map("real_name") @db.VarChar(64)
  nickname                 String?  @db.VarChar(64)
  siteId                   String   @map("site_id") @db.Uuid
  qualificationStatus      String   @default("ACTIVE") @map("qualification_status") @db.VarChar(16)
  qualificationEffectiveAt DateTime @default(now()) @map("qualification_effective_at") @db.Timestamptz(3)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion               Int      @default(1) @map("row_version")
  sourceImportBatchId      String?  @map("source_import_batch_id") @db.Uuid

  site                   Site                       @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user                   AppUser?                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceImportBatch      ImportBatch?               @relation("HostSourceImportBatch", fields: [sourceImportBatchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  operatorRelations      HostOperatorRelation[]
  qualificationHistories HostQualificationHistory[]
  bindingCodes           AccountBindingCode[]
  leaveRecords           LeaveRecord[]
  appointments           Appointment[]

  @@unique([id, siteId], map: "host_profiles_id_site_uq")
  @@index([realName], map: "host_profiles_real_name_idx")
  @@index([siteId, qualificationStatus], map: "host_profiles_site_status_idx")
  @@index([sourceImportBatchId], map: "host_profiles_source_import_batch_idx")
  @@map("host_profiles")
}

model HostQualificationHistory {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  hostId          String   @map("host_id") @db.Uuid
  fromStatus      String?  @map("from_status") @db.VarChar(16)
  toStatus        String   @map("to_status") @db.VarChar(16)
  effectiveAt     DateTime @map("effective_at") @db.Timestamptz(3)
  changedByUserId String?  @map("changed_by_user_id") @db.Uuid
  reason          String?  @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  host      HostProfile @relation(fields: [hostId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  changedBy AppUser?    @relation("HostQualificationChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([hostId, effectiveAt(sort: Desc)], map: "host_qualification_histories_host_effective_idx")
  @@index([changedByUserId, createdAt(sort: Desc)], map: "host_qualification_histories_actor_created_idx")
  @@map("host_qualification_histories")
}

model ArtistProfile {
  id                       String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                   String?   @unique(map: "artist_profiles_user_id_uq") @map("user_id") @db.Uuid
  realName                 String    @map("real_name") @db.VarChar(64)
  nickname                 String    @db.VarChar(64)
  nicknameNormalized       String    @unique(map: "artist_profiles_active_nickname_uq", where: raw("((employment_status)::text = 'ACTIVE'::text)")) @map("nickname_normalized") @db.VarChar(64)
  siteId                   String    @map("site_id") @db.Uuid
  employmentStatus         String    @default("ACTIVE") @map("employment_status") @db.VarChar(16)
  initialShiftConfiguredAt DateTime? @map("initial_shift_configured_at") @db.Timestamptz(3)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion               Int       @default(1) @map("row_version")
  sourceImportBatchId      String?   @map("source_import_batch_id") @db.Uuid

  site                Site                       @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user                AppUser?                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceImportBatch   ImportBatch?               @relation("ArtistSourceImportBatch", fields: [sourceImportBatchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bindingCodes        AccountBindingCode[]
  shiftTemplates      ArtistShiftTemplate[]
  shiftChangeRequests ArtistShiftChangeRequest[]
  overtimes           ArtistOvertime[]
  leaveRecords        LeaveRecord[]
  appointments        Appointment[]

  @@unique([id, siteId], map: "artist_profiles_id_site_uq")
  @@index([realName], map: "artist_profiles_real_name_idx")
  @@index([siteId, employmentStatus], map: "artist_profiles_site_status_idx")
  @@index([sourceImportBatchId], map: "artist_profiles_source_import_batch_idx")
  @@map("artist_profiles")
}

model ArtistShiftTemplate {
  id               String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  artistId         String                    @map("artist_id") @db.Uuid
  versionNo        Int                       @map("version_no")
  workdays         Int[]                     @db.SmallInt
  workStartMinute  Int                       @map("work_start_minute") @db.SmallInt
  breakStartMinute Int?                      @map("break_start_minute") @db.SmallInt
  breakEndMinute   Int?                      @map("break_end_minute") @db.SmallInt
  workEndMinute    Int                       @map("work_end_minute") @db.SmallInt
  validFrom        DateTime                  @map("valid_from") @db.Date
  validUntil       DateTime?                 @map("valid_until") @db.Date
  createdByUserId  String?                   @map("created_by_user_id") @db.Uuid
  sourceRequestId  String?                   @map("source_request_id") @db.Uuid
  activeRange      Unsupported("daterange")? @default(dbgenerated("daterange(valid_from, valid_until, '[)'::text)")) @map("active_range")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  artist             ArtistProfile              @relation(fields: [artistId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy          AppUser?                   @relation("ArtistShiftCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceRequest      ArtistShiftChangeRequest?  @relation("ArtistShiftResult", fields: [sourceRequestId, artistId], references: [id, artistId], onDelete: Restrict, onUpdate: Cascade, map: "artist_shift_templates_source_request_artist_fkey")
  currentForRequests ArtistShiftChangeRequest[] @relation("ArtistShiftCurrent")

  @@unique([artistId, versionNo], map: "artist_shift_templates_artist_version_uq")
  @@unique([id, artistId], map: "artist_shift_templates_id_artist_uq")
  @@unique([sourceRequestId, artistId], map: "artist_shift_templates_source_request_artist_uq")
  @@index([artistId, validFrom(sort: Desc)], map: "artist_shift_templates_artist_valid_from_idx")
  @@index([createdByUserId], map: "artist_shift_templates_created_by_idx")
  @@map("artist_shift_templates")
}

model ArtistShiftChangeRequest {
  id                       String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  artistId                 String    @map("artist_id") @db.Uuid
  siteId                   String    @map("site_id") @db.Uuid
  currentShiftId           String    @map("current_shift_id") @db.Uuid
  proposedWorkdays         Int[]     @map("proposed_workdays") @db.SmallInt
  proposedWorkStartMinute  Int       @map("proposed_work_start_minute") @db.SmallInt
  proposedBreakStartMinute Int?      @map("proposed_break_start_minute") @db.SmallInt
  proposedBreakEndMinute   Int?      @map("proposed_break_end_minute") @db.SmallInt
  proposedWorkEndMinute    Int       @map("proposed_work_end_minute") @db.SmallInt
  effectiveFrom            DateTime  @map("effective_from") @db.Date
  reason                   String    @db.VarChar(500)
  status                   String    @default("PENDING") @db.VarChar(16)
  submittedByUserId        String    @map("submitted_by_user_id") @db.Uuid
  submittedAt              DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedByUserId         String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt               DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewComment            String?   @map("review_comment") @db.VarChar(500)
  affectedAppointmentCount Int       @default(0) @map("affected_appointment_count")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion               Int       @default(1) @map("row_version")

  artist         ArtistProfile        @relation(fields: [artistId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site           Site                 @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentShift   ArtistShiftTemplate  @relation("ArtistShiftCurrent", fields: [currentShiftId, artistId], references: [id, artistId], onDelete: Restrict, onUpdate: Cascade, map: "artist_shift_change_requests_current_shift_artist_fkey")
  submittedBy    AppUser              @relation("ArtistShiftSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy     AppUser?             @relation("ArtistShiftReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resultingShift ArtistShiftTemplate? @relation("ArtistShiftResult")

  @@unique([id, artistId], map: "artist_shift_change_requests_id_artist_uq")
  @@unique([artistId], map: "artist_shift_change_requests_pending_artist_uq", where: raw("((status)::text = 'PENDING'::text)"))
  @@index([siteId, status, submittedAt], map: "artist_shift_change_requests_site_status_submitted_idx")
  @@index([submittedByUserId], map: "artist_shift_change_requests_submitted_by_idx")
  @@index([reviewedByUserId], map: "artist_shift_change_requests_reviewed_by_idx")
  @@map("artist_shift_change_requests")
}

model ArtistOvertime {
  id                       String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  artistId                 String    @map("artist_id") @db.Uuid
  siteId                   String    @map("site_id") @db.Uuid
  overtimeDate             DateTime  @map("overtime_date") @db.Date
  workStartMinute          Int       @map("work_start_minute") @db.SmallInt
  breakStartMinute         Int?      @map("break_start_minute") @db.SmallInt
  breakEndMinute           Int?      @map("break_end_minute") @db.SmallInt
  workEndMinute            Int       @map("work_end_minute") @db.SmallInt
  reason                   String    @db.VarChar(500)
  status                   String    @default("PENDING") @db.VarChar(16)
  submittedByUserId        String    @map("submitted_by_user_id") @db.Uuid
  submittedAt              DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedByUserId         String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt               DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewComment            String?   @map("review_comment") @db.VarChar(500)
  affectedAppointmentCount Int       @default(0) @map("affected_appointment_count")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion               Int       @default(1) @map("row_version")

  artist      ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site        Site          @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submittedBy AppUser       @relation("ArtistOvertimeSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy  AppUser?      @relation("ArtistOvertimeReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([artistId, overtimeDate], map: "artist_overtimes_active_artist_date_uq", where: raw("((status)::text = ANY ((ARRAY['PENDING'::character varying, 'APPROVED'::character varying])::text[]))"))
  @@index([siteId, status, overtimeDate], map: "artist_overtimes_site_status_date_idx")
  @@index([submittedByUserId], map: "artist_overtimes_submitted_by_idx")
  @@index([reviewedByUserId], map: "artist_overtimes_reviewed_by_idx")
  @@map("artist_overtimes")
}

model LeaveRecord {
  id                       String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subjectType              String                    @map("subject_type") @db.VarChar(16)
  hostId                   String?                   @map("host_id") @db.Uuid
  artistId                 String?                   @map("artist_id") @db.Uuid
  startDate                DateTime                  @map("start_date") @db.Date
  endDate                  DateTime                  @map("end_date") @db.Date
  leaveRange               Unsupported("daterange")? @default(dbgenerated("daterange(start_date, (end_date + 1), '[)'::text)")) @map("leave_range")
  status                   String                    @default("ACTIVE") @db.VarChar(16)
  reason                   String?                   @db.VarChar(500)
  createdByUserId          String                    @map("created_by_user_id") @db.Uuid
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledByUserId        String?                   @map("cancelled_by_user_id") @db.Uuid
  cancelledAt              DateTime?                 @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason       String?                   @map("cancellation_reason") @db.VarChar(500)
  affectedAppointmentCount Int                       @default(0) @map("affected_appointment_count")
  updatedAt                DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion               Int                       @default(1) @map("row_version")

  host        HostProfile?   @relation(fields: [hostId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  artist      ArtistProfile? @relation(fields: [artistId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy   AppUser        @relation("LeaveRecordCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cancelledBy AppUser?       @relation("LeaveRecordCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([hostId, startDate, endDate], map: "leave_records_host_dates_idx")
  @@index([artistId, startDate, endDate], map: "leave_records_artist_dates_idx")
  @@index([createdByUserId], map: "leave_records_created_by_idx")
  @@index([cancelledByUserId], map: "leave_records_cancelled_by_idx")
  @@map("leave_records")
}

model Appointment {
  id                           String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  hostId                       String                    @map("host_id") @db.Uuid
  hostCodeSnapshot             String                    @map("host_code_snapshot") @db.VarChar(32)
  hostNameSnapshot             String                    @map("host_name_snapshot") @db.VarChar(64)
  artistId                     String                    @map("artist_id") @db.Uuid
  artistNicknameSnapshot       String                    @map("artist_nickname_snapshot") @db.VarChar(64)
  siteId                       String                    @map("site_id") @db.Uuid
  siteNameSnapshot             String                    @map("site_name_snapshot") @db.VarChar(64)
  operatorIdAtBooking          String?                   @map("operator_id_at_booking") @db.Uuid
  operatorNameSnapshot         String?                   @map("operator_name_snapshot") @db.VarChar(64)
  appointmentDate              DateTime                  @map("appointment_date") @db.Date
  startAt                      DateTime                  @map("start_at") @db.Timestamptz(3)
  endAt                        DateTime                  @map("end_at") @db.Timestamptz(3)
  durationMinutes              Int                       @map("duration_minutes") @db.SmallInt
  timeRange                    Unsupported("tstzrange")? @default(dbgenerated("tstzrange(start_at, end_at, '[)'::text)")) @map("time_range")
  appointmentType              String                    @default("SINGLE") @map("appointment_type") @db.VarChar(16)
  status                       String                    @default("BOOKED") @db.VarChar(16)
  dailySequence                Int                       @map("daily_sequence") @db.SmallInt
  rescheduledFromAppointmentId String?                   @unique(map: "appointments_rescheduled_from_uq") @map("rescheduled_from_appointment_id") @db.Uuid
  createdByUserId              String?                   @map("created_by_user_id") @db.Uuid
  createdByRole                String                    @map("created_by_role") @db.VarChar(32)
  createdAt                    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledAt                  DateTime?                 @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId            String?                   @map("cancelled_by_user_id") @db.Uuid
  cancellationReasonCode       String?                   @map("cancellation_reason_code") @db.VarChar(64)
  cancellationReasonText       String?                   @map("cancellation_reason_text") @db.VarChar(500)
  cancellationSourceType       String?                   @map("cancellation_source_type") @db.VarChar(32)
  cancellationSourceId         String?                   @map("cancellation_source_id") @db.Uuid
  completedAt                  DateTime?                 @map("completed_at") @db.Timestamptz(3)
  updatedAt                    DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion                   Int                       @default(1) @map("row_version")

  host            HostProfile      @relation(fields: [hostId, siteId], references: [id, siteId], onDelete: Restrict, onUpdate: Cascade, map: "appointments_host_site_fkey")
  artist          ArtistProfile    @relation(fields: [artistId, siteId], references: [id, siteId], onDelete: Restrict, onUpdate: Cascade, map: "appointments_artist_site_fkey")
  site            Site             @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  operator        OperatorProfile? @relation(fields: [operatorIdAtBooking, siteId], references: [id, siteId], onDelete: Restrict, onUpdate: Cascade, map: "appointments_operator_site_fkey")
  createdBy       AppUser?         @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cancelledBy     AppUser?         @relation("AppointmentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rescheduledFrom Appointment?     @relation("AppointmentReschedule", fields: [rescheduledFromAppointmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rescheduledTo   Appointment?     @relation("AppointmentReschedule")

  @@unique([hostId, appointmentDate, dailySequence], map: "appointments_active_host_daily_sequence_uq", where: raw("((status)::text = ANY ((ARRAY['BOOKED'::character varying, 'COMPLETED'::character varying])::text[]))"))
  @@index([siteId, appointmentDate, startAt], map: "appointments_site_date_start_idx")
  @@index([hostId, appointmentDate, status], map: "appointments_host_date_status_idx")
  @@index([artistId, appointmentDate, status], map: "appointments_artist_date_status_idx")
  @@index([operatorIdAtBooking, appointmentDate], map: "appointments_operator_date_idx")
  @@index([status, startAt], map: "appointments_status_start_idx")
  @@index([createdByUserId, createdAt(sort: Desc)], map: "appointments_created_by_idx")
  @@index([cancelledByUserId, cancelledAt(sort: Desc)], map: "appointments_cancelled_by_idx")
  @@map("appointments")
}

model OperatorProfile {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId              String?  @unique(map: "operator_profiles_user_id_uq") @map("user_id") @db.Uuid
  realName            String   @map("real_name") @db.VarChar(64)
  nameNormalized      String   @map("name_normalized") @db.VarChar(64)
  siteId              String   @map("site_id") @db.Uuid
  employmentStatus    String   @default("ACTIVE") @map("employment_status") @db.VarChar(16)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion          Int      @default(1) @map("row_version")
  sourceImportBatchId String?  @map("source_import_batch_id") @db.Uuid

  site               Site                   @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user               AppUser?               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceImportBatch  ImportBatch?           @relation("OperatorSourceImportBatch", fields: [sourceImportBatchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hostRelations      HostOperatorRelation[]
  bindingCodes       AccountBindingCode[]
  bookedAppointments Appointment[]

  @@unique([id, siteId], map: "operator_profiles_id_site_uq")
  @@unique([siteId, nameNormalized], map: "operator_profiles_active_name_site_uq", where: raw("((employment_status)::text = 'ACTIVE'::text)"))
  @@index([siteId, employmentStatus], map: "operator_profiles_site_status_idx")
  @@index([sourceImportBatchId], map: "operator_profiles_source_import_batch_idx")
  @@map("operator_profiles")
}

model HostOperatorRelation {
  id                  String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  hostId              String                    @map("host_id") @db.Uuid
  operatorId          String                    @map("operator_id") @db.Uuid
  validFrom           DateTime                  @map("valid_from") @db.Date
  validUntil          DateTime?                 @map("valid_until") @db.Date
  changeReason        String?                   @map("change_reason") @db.VarChar(500)
  activeRange         Unsupported("daterange")? @default(dbgenerated("daterange(valid_from, valid_until, '[)'::text)")) @map("active_range")
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion          Int                       @default(1) @map("row_version")
  sourceImportBatchId String?                   @map("source_import_batch_id") @db.Uuid

  host              HostProfile     @relation(fields: [hostId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  operator          OperatorProfile @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceImportBatch ImportBatch?    @relation("HostOperatorRelationSourceImportBatch", fields: [sourceImportBatchId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([hostId, validFrom(sort: Desc)], map: "host_operator_relations_host_valid_from_idx")
  @@index([operatorId, validFrom, validUntil], map: "host_operator_relations_operator_validity_idx")
  @@index([sourceImportBatchId], map: "host_operator_relations_source_import_batch_idx")
  @@map("host_operator_relations")
}

model OperationLog {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  siteId            String?  @map("site_id") @db.Uuid
  objectType        String   @map("object_type") @db.VarChar(32)
  objectId          String   @map("object_id") @db.Uuid
  action            String   @db.VarChar(64)
  actorUserId       String?  @map("actor_user_id") @db.Uuid
  actorNameSnapshot String   @map("actor_name_snapshot") @db.VarChar(64)
  actorRole         String   @map("actor_role") @db.VarChar(32)
  reason            String?  @db.VarChar(500)
  beforeData        Json?    @map("before_data") @db.JsonB
  afterData         Json?    @map("after_data") @db.JsonB
  requestId         String?  @map("request_id") @db.VarChar(64)
  clientType        String?  @map("client_type") @db.VarChar(32)
  ipAddress         String?  @map("ip_address") @db.Inet
  userAgent         String?  @map("user_agent") @db.VarChar(500)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser AppUser? @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([objectType, objectId, createdAt(sort: Desc)], map: "operation_logs_object_created_idx")
  @@index([siteId, createdAt(sort: Desc)], map: "operation_logs_site_created_idx")
  @@index([actorUserId, createdAt(sort: Desc)], map: "operation_logs_actor_created_idx")
  @@map("operation_logs")
}

model ImportBatch {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  importType        String    @map("import_type") @db.VarChar(32)
  templateVersion   String    @map("template_version") @db.VarChar(16)
  mode              String    @db.VarChar(16)
  originalFilename  String    @map("original_filename") @db.VarChar(255)
  fileSha256        String    @map("file_sha256") @db.Char(64)
  storageKey        String    @map("storage_key") @db.VarChar(500)
  status            String    @default("UPLOADED") @db.VarChar(32)
  uploadedByUserId  String    @map("uploaded_by_user_id") @db.Uuid
  confirmedByUserId String?   @map("confirmed_by_user_id") @db.Uuid
  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamptz(3)
  summary           Json      @default("{}") @db.JsonB
  failureReason     String?   @map("failure_reason") @db.VarChar(500)
  startedAt         DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion        Int       @default(1) @map("row_version")

  uploadedBy                  AppUser                @relation("ImportBatchUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  confirmedBy                 AppUser?               @relation("ImportBatchConfirmer", fields: [confirmedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rows                        ImportRow[]
  sourceHosts                 HostProfile[]          @relation("HostSourceImportBatch")
  sourceArtists               ArtistProfile[]        @relation("ArtistSourceImportBatch")
  sourceOperators             OperatorProfile[]      @relation("OperatorSourceImportBatch")
  sourceHostOperatorRelations HostOperatorRelation[] @relation("HostOperatorRelationSourceImportBatch")

  @@index([importType, fileSha256, status], map: "import_batches_type_hash_status_idx")
  @@index([status, createdAt(sort: Desc)], map: "import_batches_status_created_idx")
  @@index([uploadedByUserId, createdAt(sort: Desc)], map: "import_batches_uploader_created_idx")
  @@map("import_batches")
}

model ImportRow {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  importBatchId    String    @map("import_batch_id") @db.Uuid
  sheetName        String    @map("sheet_name") @db.VarChar(128)
  rowNumber        Int       @map("row_number")
  businessKey      String?   @map("business_key") @db.VarChar(160)
  rawData          Json      @map("raw_data") @db.JsonB
  normalizedData   Json      @map("normalized_data") @db.JsonB
  validationStatus String    @map("validation_status") @db.VarChar(16)
  errors           Json      @default("[]") @db.JsonB
  plannedAction    String?   @map("planned_action") @db.VarChar(32)
  targetEntityId   String?   @map("target_entity_id") @db.Uuid
  appliedAt        DateTime? @map("applied_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion       Int       @default(1) @map("row_version")

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([importBatchId, sheetName, rowNumber], map: "import_rows_batch_sheet_row_uq")
  @@index([importBatchId, validationStatus], map: "import_rows_batch_validation_idx")
  @@index([targetEntityId], map: "import_rows_target_entity_idx")
  @@map("import_rows")
}

model AccountBindingCode {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  roleCode           String    @map("role_code") @db.VarChar(32)
  siteId             String    @map("site_id") @db.Uuid
  hostProfileId      String?   @map("host_profile_id") @db.Uuid
  artistProfileId    String?   @map("artist_profile_id") @db.Uuid
  operatorProfileId  String?   @map("operator_profile_id") @db.Uuid
  codeHash           String    @unique(map: "account_binding_codes_code_hash_uq") @map("code_hash") @db.Char(64)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  failedAttemptCount Int       @default(0) @map("failed_attempt_count")
  maxAttempts        Int       @default(5) @map("max_attempts")
  consumedAt         DateTime? @map("consumed_at") @db.Timestamptz(3)
  consumedByUserId   String?   @map("consumed_by_user_id") @db.Uuid
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedByUserId    String?   @map("revoked_by_user_id") @db.Uuid
  revokeReason       String?   @map("revoke_reason") @db.VarChar(500)
  createdByUserId    String    @map("created_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rowVersion         Int       @default(1) @map("row_version")

  site            Site             @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hostProfile     HostProfile?     @relation(fields: [hostProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  artistProfile   ArtistProfile?   @relation(fields: [artistProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  operatorProfile OperatorProfile? @relation(fields: [operatorProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       AppUser          @relation("BindingCodeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  consumedBy      AppUser?         @relation("BindingCodeConsumer", fields: [consumedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revokedBy       AppUser?         @relation("BindingCodeRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([hostProfileId], map: "account_binding_codes_active_host_uq", where: raw("(host_profile_id IS NOT NULL AND consumed_at IS NULL AND revoked_at IS NULL)"))
  @@unique([artistProfileId], map: "account_binding_codes_active_artist_uq", where: raw("(artist_profile_id IS NOT NULL AND consumed_at IS NULL AND revoked_at IS NULL)"))
  @@unique([operatorProfileId], map: "account_binding_codes_active_operator_uq", where: raw("(operator_profile_id IS NOT NULL AND consumed_at IS NULL AND revoked_at IS NULL)"))
  @@index([siteId, roleCode, createdAt(sort: Desc)], map: "account_binding_codes_site_role_created_idx")
  @@index([expiresAt], map: "account_binding_codes_expires_idx")
  @@index([createdByUserId, createdAt(sort: Desc)], map: "account_binding_codes_creator_created_idx")
  @@map("account_binding_codes")
}
