DEPLOYMENT_MODE=single-server
GATEWAY_TARGET=gateway
PUBLIC_IP=replace-with-server-public-ip
CERTBOT_EMAIL=replace-with-certificate-contact-email
NPM_REGISTRY=https://registry.npmjs.org
DEBIAN_MIRROR=http://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
APP_TIME_ZONE=Asia/Shanghai
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-unique-32-character-secret
AUTH_ACCESS_TOKEN_ISSUER=makeup-booking-api
AUTH_ACCESS_TOKEN_AUDIENCE=makeup-booking-clients
INTERNAL_WORKER_TOKEN=replace-with-another-32-character-secret

POSTGRES_DB=makeup_booking
POSTGRES_USER=makeup
POSTGRES_PASSWORD=replace-with-a-unique-database-password
DATABASE_URL=postgresql://makeup:replace-with-a-unique-database-password@postgres:5432/makeup_booking?schema=public
BACKUP_DATABASE_URL=postgresql://makeup:replace-with-a-unique-database-password@postgres:5432/makeup_booking

REDIS_PASSWORD=replace-with-a-unique-redis-password
REDIS_URL=redis://:replace-with-a-unique-redis-password@redis:6379

BOOKING_MAINTENANCE_INTERVAL_MS=60000
EXPORT_POLL_INTERVAL_MS=5000
EXPORT_CLEANUP_INTERVAL_MS=3600000
