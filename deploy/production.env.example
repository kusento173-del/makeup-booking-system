APP_TIME_ZONE=Asia/Shanghai
AUTH_BINDING_CODE_PEPPER=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-different-32-character-secret
AUTH_ACCESS_TOKEN_ISSUER=makeup-booking-api
AUTH_ACCESS_TOKEN_AUDIENCE=makeup-booking-clients
INTERNAL_WORKER_TOKEN=replace-with-another-32-character-secret
WECHAT_MINI_PROGRAM_APP_ID=replace-with-wechat-app-id
WECHAT_MINI_PROGRAM_APP_SECRET=replace-with-wechat-app-secret
DATABASE_URL=postgresql://replace-user:replace-password@replace-db-host:5432/makeup_booking?schema=public&sslmode=require
BACKUP_DATABASE_URL=postgresql://replace-user:replace-password@replace-db-host:5432/makeup_booking?sslmode=require
REDIS_URL=rediss://:replace-password@replace-redis-host:6379
BOOKING_MAINTENANCE_INTERVAL_MS=60000
EXPORT_POLL_INTERVAL_MS=5000
EXPORT_CLEANUP_INTERVAL_MS=3600000
