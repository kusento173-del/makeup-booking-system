{
  "name": "makeup-booking-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=11.9.0 <12"
  },
  "scripts": {
    "admin:bootstrap": "pnpm db:client && tsx --tsconfig apps/api/tsconfig.json apps/api/src/commands/bootstrap-admin.ts",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "prisma migrate deploy",
    "db:check": "node scripts/check-master-data-database.mjs && node scripts/check-identity-database.mjs && node scripts/check-audit-database.mjs && node scripts/check-import-database.mjs && node scripts/check-shift-database.mjs && node scripts/check-availability-exceptions-database.mjs && node scripts/check-appointment-database.mjs && node scripts/check-booking-reliability-database.mjs && node scripts/check-fixed-appointment-database.mjs && node scripts/check-export-database.mjs && pnpm db:check:booking-concurrency",
    "db:check:booking-concurrency": "node packages/database/scripts/check-booking-concurrency.mjs",
    "db:client": "pnpm db:generate && pnpm --filter @makeup/database build",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "deploy:check": "node scripts/check-production-environment.mjs",
    "dev:admin": "pnpm --parallel --filter @makeup/api --filter @makeup/admin-web --filter @makeup/worker run dev",
    "env:setup": "node scripts/ensure-local-auth-secrets.mjs",
    "e2e": "pnpm build && pnpm e2e:test",
    "e2e:test": "playwright test",
    "e2e:web-roles": "node scripts/run-web-role-e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:check": "node scripts/check-infrastructure.mjs",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs --follow postgres redis",
    "infra:status": "docker compose ps",
    "infra:up": "docker compose up --detach --wait",
    "lint": "eslint .",
    "prepare": "node .husky/install.mjs",
    "security:audit": "pnpm audit --prod --audit-level high",
    "security:audit:all": "pnpm audit --audit-level high",
    "security:check": "pnpm security:files && pnpm security:audit",
    "security:files": "node scripts/check-tracked-files.mjs",
    "test": "pnpm -r --if-present run test",
    "test:capacity": "node scripts/run-web-capacity-test.mjs",
    "typecheck": "pnpm db:client && tsc -p tsconfig.tools.json --noEmit && pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "catalog:",
    "@types/node": "24.13.3",
    "dotenv": "catalog:",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "3.9.6",
    "prisma": "catalog:",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
