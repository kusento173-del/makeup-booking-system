{
  "name": "makeup-booking-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=11.9.0 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:check": "node scripts/check-infrastructure.mjs",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs --follow postgres redis",
    "infra:status": "docker compose ps",
    "infra:up": "docker compose up --detach --wait",
    "lint": "eslint .",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "dotenv": "catalog:",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "prisma": "catalog:",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
