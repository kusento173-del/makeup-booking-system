NODE_ENV=development
APP_TIME_ZONE=Asia/Shanghai
API_PORT=3000
AUTH_BINDING_CODE_PEPPER=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_ISSUER=makeup-booking-api
AUTH_ACCESS_TOKEN_AUDIENCE=makeup-booking-clients
INTERNAL_WORKER_TOKEN=replace-with-at-least-32-random-characters
INTERNAL_API_URL=http://127.0.0.1:3000
FIXED_GENERATION_INTERVAL_MS=60000
EXPORT_POLL_INTERVAL_MS=5000
EXPORT_CLEANUP_INTERVAL_MS=3600000
EXPORT_STORAGE_DIR=var/exports
NOTIFICATION_CHANNEL=WECHAT_MINI_PROGRAM
NOTIFICATION_OUTBOX_INTERVAL_MS=2000
NOTIFICATION_DELIVERY_INTERVAL_MS=1000
WECHAT_MINI_PROGRAM_APP_ID=replace-with-wechat-app-id
WECHAT_MINI_PROGRAM_APP_SECRET=replace-with-wechat-app-secret
WECHAT_MINI_PROGRAM_STATE=formal
WECHAT_MINI_PROGRAM_NOTIFICATION_PAGE=
POSTGRES_DB=makeup_booking
POSTGRES_USER=makeup
POSTGRES_PASSWORD=makeup_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://makeup:makeup_local@localhost:5432/makeup_booking?schema=public
REDIS_PASSWORD=makeup_local
REDIS_PORT=6379
REDIS_URL=redis://:makeup_local@localhost:6379
